{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts"],
  "exclude": ["src/**/*.test.ts", "src/**/testFixtures.ts"]
}
