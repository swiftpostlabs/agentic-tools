{
  "name": "agentic-tools",
  "version": "0.1.0",
  "description": "Shared agent skills and the agentic-tools CLI for policy, skills, plugin, and export workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftpostlabs/agentic-tools.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentic-tools": "./dist/cli.js"
  },
  "files": [
    ".agents/skills",
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "cli": "node src/cli.ts",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.skills.json",
    "lint": "node src/cli.ts policy check && node src/cli.ts plugin check && node scripts/check-version-drift.mts check && node scripts/project-assistant-instructions.mts --check",
    "version:check": "node scripts/check-version-drift.mts check",
    "assistants:build": "node scripts/project-assistant-instructions.mts",
    "assistants:check": "node scripts/project-assistant-instructions.mts --check",
    "validate:skills": "node .agents/skills/ref-sp-agents-skills-authoring/scripts/validate-skill.mts .agents/skills --all",
    "validate:sharing": "node .agents/skills/ref-sp-agents-shareable-skills/scripts/validate-sharing.mts .agents/skills --all",
    "validate": "node .agents/skills/ref-sp-agents-skills-authoring/scripts/validate-skill.mts .agents/skills --all && node .agents/skills/ref-sp-agents-shareable-skills/scripts/validate-sharing.mts .agents/skills --all",
    "check:drift": "node .agents/skills/ref-sp-agents-shareable-skills/scripts/check-vendored-drift.mts .agents/skills",
    "pack": "npm pack --dry-run",
    "playwright": "playwright-cli"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "json5": "^2.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/cli": "^0.1.17",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
